<Window x:Class="AlunosTech.Unifica.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unifica — Central de Serviços (Alunos Tech)"
        Width="1100" Height="680" WindowStartupLocation="CenterScreen">
  <!-- A janela só tem ligações (bindings) com o ViewModel; não há regra de negócio aqui (MVVM). -->
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,6,0" />
      <ComboBox Width="190" ItemsSource="{Binding OpcoesFiltro}" SelectedItem="{Binding FiltroStatus}" />
      <Button Content="Atualizar" Command="{Binding CarregarComando}" Margin="8,0,8,0" />
      <TextBlock Text="{Binding Mensagem}" Foreground="DarkRed" VerticalAlignment="Center" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
      <Button Content="◀ Anterior" Command="{Binding PaginaAnteriorComando}" />
      <Button Content="Próxima ▶" Command="{Binding ProximaPaginaComando}" />
      <TextBlock Text="{Binding Paginacao}" VerticalAlignment="Center" />
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="2*" />
      </Grid.ColumnDefinitions>

      <!-- Fila de atendimento ordenada pelo prazo do SLA. -->
      <DataGrid Grid.Column="0" ItemsSource="{Binding Ordens}" SelectedItem="{Binding OrdemSelecionada}"
                AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Protocolo" Binding="{Binding Protocolo}" />
          <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="*" />
          <DataGridTextColumn Header="Título" Binding="{Binding Titulo}" Width="2*" />
          <DataGridTextColumn Header="Prioridade" Binding="{Binding Prioridade}" />
          <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
          <DataGridTextColumn Header="Prazo (UTC)" Binding="{Binding PrazoSla, StringFormat=dd/MM HH:mm}" />
          <DataGridTextColumn Header="SLA" Binding="{Binding SituacaoSla}" />
        </DataGrid.Columns>
      </DataGrid>

      <!-- Detalhe da ordem selecionada. -->
      <Border Grid.Column="1" Margin="12,0,0,0" Padding="12" BorderBrush="{StaticResource Destaque}" BorderThickness="1">
        <StackPanel>
          <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Detalhe.Protocolo}" />
          <TextBlock Text="{Binding Detalhe.Titulo}" TextWrapping="Wrap" Margin="0,4,0,0" />
          <TextBlock Text="{Binding Detalhe.Cliente}" Foreground="Gray" />
          <TextBlock Margin="0,8,0,0" Text="{Binding Detalhe.Status, StringFormat=Status atual: {0}}" />
          <TextBlock Text="{Binding Detalhe.HorasApontadas, StringFormat=Horas apontadas: {0:N2}}" />

          <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Text="Alterar status" />
          <StackPanel Orientation="Horizontal">
            <ComboBox Width="190" ItemsSource="{Binding ProximosStatus}" SelectedItem="{Binding NovoStatus}" />
            <Button Content="Aplicar" Command="{Binding AlterarStatusComando}" Margin="8,0,0,0" />
          </StackPanel>

          <TextBlock Margin="0,16,0,4" FontWeight="SemiBold" Text="Apontar horas (somente em atendimento)" />
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Horas:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Width="60" Text="{Binding Horas, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
          <TextBox Margin="0,6,0,0" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                   Text="{Binding DescricaoApontamento, UpdateSourceTrigger=PropertyChanged}" />
          <Button Margin="0,6,0,0" HorizontalAlignment="Left" Content="Registrar" Command="{Binding ApontarComando}" />
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
