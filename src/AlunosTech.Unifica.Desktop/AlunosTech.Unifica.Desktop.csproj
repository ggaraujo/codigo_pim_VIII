<Project Sdk="Microsoft.NET.Sdk">

  <!-- Módulo desktop (WPF) da central de serviços. Compila apenas no Windows. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>Unifica — Central de Serviços</ApplicationTitle>
  </PropertyGroup>

  <ItemGroup>
    <!-- Login corporativo (Microsoft Entra ID) e obtenção do token para a API. -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.92.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AlunosTech.Unifica.Desktop.Nucleo\AlunosTech.Unifica.Desktop.Nucleo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
